# Default: normalize text to LF in the repo AND in the working tree (identical bytes on every clone, any OS/autocrlf).
* text=auto eol=lf

# ---- Unity YAML (Force Text serialization), merged with Unity's Smart Merge ----
*.unity      text eol=lf merge=unityyamlmerge
*.prefab     text eol=lf merge=unityyamlmerge
*.asset      text eol=lf merge=unityyamlmerge
*.mat        text eol=lf merge=unityyamlmerge
*.anim       text eol=lf merge=unityyamlmerge
*.controller text eol=lf merge=unityyamlmerge
*.overrideController text eol=lf merge=unityyamlmerge
*.physicMaterial text eol=lf merge=unityyamlmerge
*.lighting   text eol=lf merge=unityyamlmerge
*.playable   text eol=lf merge=unityyamlmerge
*.meta       text eol=lf

# ---- Unity assets that stay BINARY even with Force Text (lesson: a text rule corrupted a terrain) ----
# These lines MUST stay after "*.asset" (the last matching line wins).
*TerrainData*.asset filter=lfs diff=lfs merge=lfs -text
LightingData.asset  filter=lfs diff=lfs merge=lfs -text
NavMesh.asset       filter=lfs diff=lfs merge=lfs -text
NavMesh-*.asset     filter=lfs diff=lfs merge=lfs -text
*.cubemap           filter=lfs diff=lfs merge=lfs -text

# ---- Code / text ----
*.cs     text eol=lf diff=csharp
*.shader text eol=lf
*.hlsl   text eol=lf
*.cginc  text eol=lf
*.compute text eol=lf
*.asmdef text eol=lf
*.json   text eol=lf
*.inputactions text eol=lf
*.uss    text eol=lf
*.uxml   text eol=lf
*.md     text eol=lf
*.py     text eol=lf diff=python
*.cmd    text eol=crlf
*.bat    text eol=crlf
*.ps1    text eol=crlf

